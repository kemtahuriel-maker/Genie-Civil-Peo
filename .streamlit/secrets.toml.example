# Copy these into Streamlit Community Cloud > App settings > Secrets
# (or into .streamlit/secrets.toml for local tests; never commit the real file).

# Choose strong, different passwords. If NONE is set, the app is open to everyone as admin.
ADMIN_PASSWORD = "change-me-admin"
EDITOR_PASSWORD = "change-me-editor"
VIEWER_PASSWORD = "change-me-viewer"

# Free Postgres (Neon / Supabase) so data survives restarts
DATABASE_URL = "postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Optional: set to "0" to stop demo data auto-loading (only matters if demo_data.json exists)
# AUTO_DEMO = "0"
